# ---------- Core ----------
# Leave empty for local development (an embedded PostgreSQL is stored in ./.pglite).
# In production paste your PostgreSQL URL from Neon or Supabase — see docs/SETUP.md
DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Long random string: run `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL="chellskct@gmail.com"
ADMIN_PASSWORD="change-this-password"

# ---------- Razorpay (https://dashboard.razorpay.com → Account & Settings → API Keys) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhooks → Add webhook → URL: https://YOUR-DOMAIN/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Email notifications (any SMTP: Gmail app password, Zoho, Brevo, Resend SMTP) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Salad Stories <orders@yourdomain.com>"
OWNER_EMAIL="chellskct@gmail.com"

# ---------- WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup) ----------
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Owner's WhatsApp number in international format without +, e.g. 919876543210
OWNER_WHATSAPP_NUMBER=""

# ---------- Image uploads (optional; Cloudinary → Settings → Upload → unsigned preset) ----------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

# ---------- Free owner alerts on Telegram (optional) ----------
# Telegram → @BotFather → /newbot → copy the token. Chat ID goes in Admin → Settings.
TELEGRAM_BOT_TOKEN=""

# Free WhatsApp alerts to the owner (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_APIKEY=

# Free phone notifications sent by the site (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduler (optional; falls back to AUTH_SECRET)
CRON_SECRET=
# Test site only (Netlify branch-deploy context) — never set for production
# TEST_DATABASE_URL=
# TEST_AUTH_SECRET=
